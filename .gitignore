# Recorded data never belongs in git: it is large, it does not diff, and it carries
# real machine behaviour. See examples/README.md before committing anything from a
# real installation.
*.svdx
*.svd
*.parquet
*.tdms

# Derived artefacts
*.png
.cache/
__pycache__/

# Generated fixtures - tests/make_fixture.py and tests/make_real_fixtures.py
# recreate them on demand.
tests/fixtures/*.csv
tests/fixtures/ground_truth.json
tests/fixtures/real/

# Eval fixtures are generated too, and eval runs hold one agent answer per
# cell - transcripts of a measurement, not part of the skill.
evals/fixtures/
evals/ground_truth.json
evals/runs/
evals/summary.json

# Local tool discovery
config.json

# Local issue-tracker and agent scaffolding, if the maintainer's tooling creates
# it here. It is private workflow state, not part of the skill, and an auto-
# generated AGENTS.md in particular carries instructions meant for one person's
# setup rather than for anyone installing this.
.beads/
.dolt/
*.db
.beads-credential-key
/AGENTS.md

# Agent session state: local settings, transcripts and the scratch git worktrees
# that background jobs run in. Machine-specific and often verbatim working notes,
# so it is the last place anything private should be able to reach a public repo.
.claude/
